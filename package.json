{
  "name": "curio-knowledge-base",
  "version": "1.0.0",
  "description": "A reusable, AI-assisted knowledge base for teams.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node --env-file-if-exists=.env.local scripts/validate-runtime-env.mjs",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:extension": "vitest run tests/extension",
    "test:extension:chrome": "node scripts/smoke-extension-chrome.mjs",
    "test:rls": "supabase test db",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "extension:build": "node scripts/build-extension.mjs",
    "extension:assets": "node scripts/generate-extension-brand-assets.mjs",
    "extension:store-assets": "npm run extension:assets && node scripts/capture-extension-store-assets.mjs",
    "media:capture": "node scripts/capture-product-tour.mjs",
    "media:prepare": "node scripts/prepare-product-media.mjs",
    "configuration:sync": "node --env-file-if-exists=.env.local scripts/sync-configuration.mjs",
    "fixtures:members": "node --env-file-if-exists=.env.local scripts/member-fixtures.mjs seed",
    "fixtures:members:cleanup": "node --env-file-if-exists=.env.local scripts/member-fixtures.mjs cleanup",
    "storage:cleanup-staging": "node --env-file-if-exists=.env.local scripts/cleanup-thumbnail-uploads.mjs",
    "storage:reclassify-placeholders": "node --env-file-if-exists=.env.placeholder-repair.local scripts/reclassify-placeholder-thumbnails.mjs",
    "migration:export": "node scripts/export-legacy.mjs",
    "migration:import": "node scripts/import-legacy.mjs",
    "sbom": "cyclonedx-npm --package-lock-only --output-reproducible --validate --output-file artifacts/sbom.cdx.json --output-format JSON"
  },
  "dependencies": {
    "@google/genai": "2.17.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "tailwind-merge": "3.6.0",
    "workflow": "4.8.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "ajv-formats-draft2019": "1.6.1",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "jsdom": "28.0.0",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "@emnapi/core": "1.11.3",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
    "js-yaml": "4.3.2",
    "nanoid": "5.1.16",
    "undici": "7.29.0",
    "ws": "8.21.3"
  }
}
