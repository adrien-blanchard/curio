# Public application settings
NEXT_PUBLIC_APP_NAME=Curio
NEXT_PUBLIC_ORGANIZATION_NAME=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEMO_ENABLED=true

# Supabase (create a new project; never reuse legacy credentials)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
API_TOKEN_PEPPER=

# Access control (comma-separated; configure at least one allowed address or domain)
ALLOWED_EMAIL_ADDRESSES=
ALLOWED_EMAIL_DOMAINS=
DEFAULT_USER_ROLE=contributor
INITIAL_ADMIN_EMAILS=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
THUMBNAIL_PROVIDER=none
MICROLINK_API_KEY=

# Chrome extension
EXTENSION_ENABLED=false
ALLOWED_EXTENSION_IDS=
NEXT_PUBLIC_EXTENSION_INSTALL_URL=

# Privacy and security contact
PRIVACY_CONTACT_EMAIL=
